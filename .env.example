# =====================================================================
# Cakes by ELI — примерна конфигурация
# Копирайте във .env.local и попълнете реалните стойности.
# НИКОГА не качвайте .env.local в git.
# =====================================================================

# --- Приложение ------------------------------------------------------
# Публичният адрес на сайта. Използва се за връзки в имейли и за QR кода.
APP_URL="http://localhost:3000"

# --- База данни ------------------------------------------------------
# В ПРОДУКЦИЯ е задължителен: реален PostgreSQL сървър.
#   DATABASE_URL="postgresql://user:password@host:5432/cakesbyeli?sslmode=require"
# Ако е празен, приложението ползва вградена PGlite база (истински PostgreSQL
# във WASM) в папката по-долу — само за разработка и тестове.
DATABASE_URL=
PGLITE_DIR=".data/pglite"

# --- Админ достъп ----------------------------------------------------
# Имейлът и паролата се сравняват директно с въведеното във формата за вход.
# Паролата стои в чист вид тук и в Render — пазете тези променливи.
ADMIN_EMAIL="eli@cakesbyeli.bg"
ADMIN_PASSWORD=
ADMIN_NAME="Ели"

# Подписва сесийната бисквитка. Минимум 32 знака, случаен низ.
# Генериране:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_HOURS=12

# --- Имейл -----------------------------------------------------------
# console = писмата се записват в лога (разработка)
# resend  = изпращане през Resend HTTP API
# smtp    = изпращане през SMTP сървър
EMAIL_PROVIDER="console"
EMAIL_FROM="Cakes by ELI <poruchki@cakesbyeli.bg>"
EMAIL_API_KEY=
SMTP_URL=
# Адресът, на който собственикът получава известия за нови поръчки.
OWNER_NOTIFICATION_EMAIL=

# --- Съхранение на файлове ------------------------------------------
# local = public/uploads (разработка и малък VPS)
# s3    = S3-съвместимо хранилище (препоръчано за продукция)
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="public/uploads"
STORAGE_PUBLIC_PREFIX="/uploads"
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Ограничения при качване на файлове (налагат се на сървъра).
UPLOAD_MAX_FILE_MB=6
UPLOAD_MAX_FILES=5

# --- Еконт -----------------------------------------------------------
# demo       -> https://demo.econt.com/ee/services/
# production -> https://ee.econt.com/services/
ECONT_ENVIRONMENT="demo"
# Демо достъпът на Еконт е публичен и е подходящ за тестване:
ECONT_USERNAME="iasp-dev"
ECONT_PASSWORD="1Asp-dev"

# Данни за подателя. CITY_ID е от номенклатурата на Еконт
# (Плевен = 32, София = 41). Улицата трябва да съвпада с номенклатурата,
# включително представката „ул.“ / „бул.“.
ECONT_SENDER_NAME="Cakes by ELI"
ECONT_SENDER_PHONE="0878576728"
# Задължително при юридическо лице — упълномощено лице.
ECONT_SENDER_AGENT_NAME=
ECONT_SENDER_CITY_ID="32"
ECONT_SENDER_CITY_NAME="Плевен"
ECONT_SENDER_POST_CODE="5800"
ECONT_SENDER_QUARTER=
ECONT_SENDER_STREET=
ECONT_SENDER_STREET_NUM=
ECONT_SENDER_OTHER="пл. Възраждане 1"
# Ако изпращате от офис на Еконт вместо от адрес:
ECONT_SENDER_OFFICE_CODE=
